programa {
  funcao inicio() {
    //entendimento
    //calcular o preço que romero vai vender suas artes
    //infos
    real custo, preco_venda
    //entrada de dados
    escreva("Quanto foi pago na obra: R$")
    leia(custo)
    //processamento
    preco_venda = custo * 3

    //saída
    escreva("O preço para venda é: R$" + preco_venda)
  }
}
