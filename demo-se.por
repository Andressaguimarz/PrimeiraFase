programa {
  funcao inicio() {
    inteiro idade
    cadeia nome

    escreva("Qual sua idade? ")
    leia(idade)
    escreva("Qual seu nome? ")
    leia(nome)




    se(idade < 18){
   escreva("Você é menor, pode entrar!")}
   se(idade >= 18) {
    escreva("Você é de maior, não pode!")
   }
   se(nome == "Andressa"){
   escreva("\nVocê pode entrar escondido...")
   }
  se(nome != "Andressa"){
    escreva("\nVocê não deveria estar aqui...")
    
  }
   
   
   } }
